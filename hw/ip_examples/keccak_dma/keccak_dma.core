CAPI=2:

name: "example:ip:keccak_dma"
description: "Keccak-f[1600] DMA external peripheral"

filesets:
    files_rtl:
        depend:
            - pulp-platform.org::common_cells
        files:
            - rtl/common.sv
            - rtl/keccak_reg_pkg.sv
            - rtl/keccak_reg_top.sv
            - rtl/keccak_round_constants.sv
            - rtl/keccak_round.sv
            - rtl/keccak_data.sv
            - rtl/keccak.sv
            - rtl/keccak_top.sv
            - rtl/keccak_dma_wrapper.sv
        file_type: systemVerilogSource

targets:
    default:
        filesets:
            - files_rtl
